# Copy to .env and fill in what you have. Everything is optional: with no keys at all,
# CheckAm still runs every free check and decides with its offline rules.

# --- Reasoning model (PROVIDER=auto picks Meterless Nightshift, then NVIDIA, then Gemini, then offline) ---
PROVIDER=auto
# Meterless Nightshift (primary): copy the URL and runtime token from Nightshift's Console.
# Your NVIDIA key goes in Nightshift's Providers tab, not here. Empty model = pick a Nemotron route.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
# Fallback when Nightshift isn't running: a free key from build.nvidia.com (Nemotron).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Free key from aistudio.google.com/apikey. Free-tier prompts may be used by Google: test only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Data layer: Zetaris (local Docker install). Empty key = sample mode from the bundled JSON. ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# --- Extra evidence (optional, free tiers) ---
# tavily.com: web and X search about the company or site.
TAVILY_API_KEY=
# Google Cloud console: Safe Browsing API key.
GOOGLE_SAFE_BROWSING_KEY=
# auth.abuse.ch: URLhaus malware link lookups.
URLHAUS_AUTH_KEY=

# --- Chat apps: each one starts when its token is set ---
# Telegram: create a NEW bot with @BotFather (don't reuse the CommunityOps bot token).
TELEGRAM_BOT_TOKEN=
# Discord: discord.com/developers/applications > Bot > Reset Token. Turn on Message Content Intent.
DISCORD_BOT_TOKEN=
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you choose; type the same word in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Turns on signature checks for incoming webhooks.
WHATSAPP_APP_SECRET=
PORT=8080

# --- Limits for a public bot ---
USER_LIMIT=10
USER_WINDOW_SECONDS=600
DAILY_CAP=500
DB_PATH=checkam.db
