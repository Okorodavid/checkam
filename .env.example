# Copy to .env and fill in what you have. Everything is optional: with no keys at all,
# CheckAm still runs every free check and decides with its offline rules.

# --- Reasoning model (PROVIDER=auto picks NVIDIA, then Gemini, then offline) ---
PROVIDER=auto
# Free key from build.nvidia.com (Nemotron). This is the sponsor model for the Open Agent hackathon.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Free key from aistudio.google.com/apikey. Free-tier prompts may be used by Google: test only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Extra evidence (optional, free tiers) ---
# tavily.com: web and X search about the company or site.
TAVILY_API_KEY=
# Google Cloud console: Safe Browsing API key.
GOOGLE_SAFE_BROWSING_KEY=
# auth.abuse.ch: URLhaus malware link lookups.
URLHAUS_AUTH_KEY=

# --- Chat apps: each one starts when its token is set ---
# Telegram: create a NEW bot with @BotFather (don't reuse the CommunityOps bot token).
TELEGRAM_BOT_TOKEN=
# Discord: discord.com/developers/applications > Bot > Reset Token. Turn on Message Content Intent.
DISCORD_BOT_TOKEN=
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you choose; type the same word in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Turns on signature checks for incoming webhooks.
WHATSAPP_APP_SECRET=
PORT=8080

# --- Limits for a public bot ---
USER_LIMIT=10
USER_WINDOW_SECONDS=600
DAILY_CAP=500
DB_PATH=checkam.db
